#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
eval "$(scripts/dev-env --shell)"

for name in local-cloud-worker detector direct-gcp-reader console api payments identity; do
  pid_file="$SOLVAN_STATE_DIR/pids/$name.pid"
  if [[ -f "$pid_file" ]]; then
    pid="$(tr -d '[:space:]' < "$pid_file")"
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid"
      for _ in {1..20}; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
      done
    fi
    rm -f "$pid_file"
  fi
done

if [[ -S "$SOLVAN_LOCAL_READER_SOCKET_PATH" ]]; then
  rm "$SOLVAN_LOCAL_READER_SOCKET_PATH"
fi
if [[ -f "$SOLVAN_LOCAL_READER_TOKEN_FILE" ]]; then
  rm "$SOLVAN_LOCAL_READER_TOKEN_FILE"
fi

if docker info >/dev/null 2>&1; then
  docker compose -f infra/local/compose.yaml down >/dev/null
fi
echo "Stopped Solvan worktree $SOLVAN_WORKTREE_ID. Persistent local DB volume was retained."
