CONTRACT_PORT="$(docker port "$CONTRACT_CONTAINER" 5432/tcp | sed 's/.*://')"

# Run one integration suite against the contract database and refuse a result
# that proves nothing. Every integration file is skipif-gated on
# SOLVAN_TEST_DATABASE_URL, so a renamed variable, an unreachable container or a
# collection error yields "N skipped" and exit 0 — a green gate that executed no
# contract at all. Skips and empty runs are therefore failures here.
#
# `set -e` aborts on a failing assignment, so capturing the exit status on the
# next line never ran: a failing suite exited the script before its output was
# printed, and the gate reported nothing but a bare exit code. Capture the
# status on the assignment itself so the failure is readable.
run_contract_suite() {
  local output output_file status=0
  local -a pytest_args=(-q)
  if [[ "${SOLVAN_CONTRACT_VERBOSE:-0}" == "1" ]]; then
    pytest_args=(-vv)
  fi
  if [[ "${SOLVAN_COLLECT_COVERAGE:-0}" == "1" ]]; then
    # `scripts/check` erases once before entering this gate. Every shard then
    # appends to the same branch-compatible data file so the final report
    # measures all Python tests the canonical check actually executed.
    pytest_args+=(--cov=solvan --cov=apps --cov-append --cov-report= --cov-fail-under=0)
  fi
  output_file="$(mktemp -t solvan-contract-output.XXXXXX)"
  set +e
  SOLVAN_TEST_DATABASE_URL="postgresql://postgres:solvan-contract-check@127.0.0.1:${CONTRACT_PORT}/postgres" \
    uv run pytest "${pytest_args[@]}" "$@" 2>&1 | tee "$output_file"
  status="${PIPESTATUS[0]}"
  set -e
  output="$(<"$output_file")"
  rm -f "$output_file"
  if [[ "$status" -ne 0 ]]; then
    exit "$status"
  fi
  if grep -qE '[0-9]+ skipped' <<<"$output"; then
    echo "Integration tests were skipped; the contract gate proved nothing." >&2
    exit 1
  fi
  if ! grep -qE '[0-9]+ passed' <<<"$output"; then
    echo "No integration test executed; the contract gate proved nothing." >&2
    exit 1
  fi
}

