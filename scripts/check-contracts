  'from tools.bootstrap_database import RELAY_TABLES; print(len(RELAY_TABLES))')"

if [[ "$RELAY_TABLES" != "$EXPECTED_RELAY_TABLES" ]]; then
  echo "Expected $EXPECTED_RELAY_TABLES Solvant Relay target tables; found $RELAY_TABLES." >&2
  exit 1
fi

echo "Target Solvant Relay schema checked ($RELAY_TABLES tables; not release DDL)"
