#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

uv run python tools/check_contracts.py
uv run python tools/check_relay_contract.py

CONTRACT_CONTAINER="solvan-contracts-$$"
cleanup_contract_container() {
  docker stop "$CONTRACT_CONTAINER" >/dev/null 2>&1 || true
}
trap cleanup_contract_container EXIT

docker run --rm -d \
  --name "$CONTRACT_CONTAINER" \
  -p 127.0.0.1::5432 \
  -e POSTGRES_PASSWORD=solvan-contract-check \
  postgres:16-alpine >/dev/null

# Cold containerd snapshots can take more than ten seconds on a loaded
# workstation. Keep the wait bounded, but do not misreport initialization
# latency as a schema failure.
# The official image briefly starts a bootstrap server before shutting it down
# and launching the final server. A single successful pg_isready in that
# interval is a false positive, so require three consecutive healthy probes.
ready_count=0
for _attempt in {1..150}; do
  if docker exec "$CONTRACT_CONTAINER" pg_isready -U postgres >/dev/null 2>&1; then
    ((ready_count += 1))
    if [[ "$ready_count" -ge 3 ]]; then
      break
    fi
  else
    ready_count=0
  fi
  sleep 0.2
done

if [[ "$ready_count" -lt 3 ]] \
  || ! docker exec "$CONTRACT_CONTAINER" pg_isready -U postgres >/dev/null 2>&1; then
  echo "PostgreSQL 16 contract container did not become ready." >&2
  exit 1
fi

docker exec -i "$CONTRACT_CONTAINER" \
  psql -v ON_ERROR_STOP=1 -q -U postgres -d postgres \
  < specs/artifacts/schema.sql

docker exec -i "$CONTRACT_CONTAINER" \
  psql -v ON_ERROR_STOP=1 -q -U postgres -d postgres \
  < specs/artifacts/schema-contract-tests.sql
echo "PostgreSQL constraint-oracle checks passed"

