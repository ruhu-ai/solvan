# syntax=docker/dockerfile:1.10
FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

ENV PATH=/runtime/.venv/bin:${PATH} \
    PYTHONPATH=/app/src:/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /runtime
RUN groupadd --system --gid 10001 solvan \
    && useradd --system --uid 10001 --gid solvan --home-dir /app solvan \
    && pip install --no-cache-dir uv==0.10.9

COPY apps/antigravity_workspace/pyproject.toml apps/antigravity_workspace/uv.lock ./
RUN uv sync --frozen --no-dev \
    && pip uninstall --yes uv

WORKDIR /app
COPY src ./src
COPY apps/antigravity_workspace ./apps/antigravity_workspace
RUN python apps/antigravity_workspace/verify_runtime.py \
    --lock=/runtime/uv.lock \
    && chown -R solvan:solvan /app /runtime

USER 10001:10001
EXPOSE 8080
CMD ["uvicorn", "apps.antigravity_workspace.main:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
