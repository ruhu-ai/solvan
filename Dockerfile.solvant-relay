# syntax=docker/dockerfile:1.10
# Customer-resident, outbound-only Solvant Relay worker. This image exposes no
# port and is intentionally separate from the control plane and Action Actuator.
FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

ENV PATH=/app/.venv/bin:${PATH} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
RUN groupadd --system --gid 10001 solvant-relay \
    && useradd --system --uid 10001 --gid solvant-relay --home-dir /app solvant-relay \
    && pip install --no-cache-dir uv==0.10.9

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY apps/solvant_relay ./apps/solvant_relay
COPY specs/artifacts ./specs/artifacts
RUN uv sync --frozen --no-dev --no-editable \
    && chown -R solvant-relay:solvant-relay /app

USER 10001:10001
ENTRYPOINT ["python", "-m", "apps.solvant_relay.main"]
