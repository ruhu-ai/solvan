docs/resolve-examples/
docs/google-challenge/

# Downloaded OAuth client files. These carry a client secret, and they sit
# inside the repository, so one `git add -A` would publish it. Ignored by path
# rather than by extension: the risk is the credential, not the format.
JSON/
client_secret*.json
