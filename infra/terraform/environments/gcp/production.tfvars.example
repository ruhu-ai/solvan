# A normal product deployment. Replace every placeholder in an operator-owned
# copy; do not enable the synthetic competition workload in this environment.
project_id         = "REPLACE_WITH_SOLVAN_PRODUCTION_PROJECT_ID"
billing_account_id = "REPLACE_WITH_BILLING_ACCOUNT_ID"
environment        = "production"
monthly_budget_usd = 500
# Delivery address for operational alerts and budget thresholds. Unset means
# the alert policies still exist and still fire, but tell nobody.
alert_notification_email = "REPLACE_WITH_ONCALL_ADDRESS"
database_admin_secret_name = "REPLACE_WITH_REGION_BOUND_SECRET_NAME"

organization_id  = "org_REPLACE_WITH_ULID"
scope_project_id = "prj_REPLACE_WITH_ULID"
environment_id   = "env_REPLACE_WITH_ULID"
release_commit   = "UNCONFIGURED"
deployment_id    = "UNCONFIGURED"

images = {
  api                   = "europe-west1-docker.pkg.dev/PROJECT/solvan/api@sha256:REPLACE"
  alert_ingress         = "europe-west1-docker.pkg.dev/PROJECT/solvan/alert-ingress@sha256:REPLACE"
  direct_gcp_reader     = "europe-west1-docker.pkg.dev/PROJECT/solvan/direct-gcp-reader@sha256:REPLACE"
  pilot_qualification_verifier = "europe-west1-docker.pkg.dev/PROJECT/solvan/pilot-qualification-verifier@sha256:REPLACE"
  coordinator           = "europe-west1-docker.pkg.dev/PROJECT/solvan/coordinator@sha256:REPLACE"
  detector              = "europe-west1-docker.pkg.dev/PROJECT/solvan/detector@sha256:REPLACE"
  actuator              = "europe-west1-docker.pkg.dev/PROJECT/solvan/actuator@sha256:REPLACE"
  evidence_broker       = "europe-west1-docker.pkg.dev/PROJECT/solvan/evidence-broker@sha256:REPLACE"
  verifier              = "europe-west1-docker.pkg.dev/PROJECT/solvan/verifier@sha256:REPLACE"
  payments_good         = "europe-west1-docker.pkg.dev/PROJECT/solvan/payments-good@sha256:REPLACE"
  payments_bad          = "europe-west1-docker.pkg.dev/PROJECT/solvan/payments-bad@sha256:REPLACE"
  console               = "europe-west1-docker.pkg.dev/PROJECT/solvan/console@sha256:REPLACE"
  outbox_publisher      = "europe-west1-docker.pkg.dev/PROJECT/solvan/publisher@sha256:REPLACE"
  memory_promoter       = "europe-west1-docker.pkg.dev/PROJECT/solvan/memory-promoter@sha256:REPLACE"
  antigravity_workspace = "europe-west1-docker.pkg.dev/PROJECT/solvan/antigravity-workspace@sha256:REPLACE"
  workspace_sandbox     = "europe-west1-docker.pkg.dev/PROJECT/solvan/workspace-sandbox@sha256:REPLACE"
  workspace_adapter     = "europe-west1-docker.pkg.dev/PROJECT/solvan/workspace-adapter@sha256:REPLACE"
  fixture_attester      = "europe-west1-docker.pkg.dev/PROJECT/solvan/fixture-attester@sha256:REPLACE"
  release_admin         = "europe-west1-docker.pkg.dev/PROJECT/solvan/release-admin@sha256:REPLACE"
  github_provider       = "europe-west1-docker.pkg.dev/PROJECT/solvan/github-provider@sha256:REPLACE"
  github_identity_broker = "europe-west1-docker.pkg.dev/PROJECT/solvan/github-identity-broker@sha256:REPLACE"
  deployment_controller  = "europe-west1-docker.pkg.dev/PROJECT/solvan/deployment-controller@sha256:REPLACE"
  release_verifier        = "europe-west1-docker.pkg.dev/PROJECT/solvan/release-verifier@sha256:REPLACE"
  slack_liaison         = "europe-west1-docker.pkg.dev/PROJECT/solvan/slack-liaison@sha256:REPLACE"
  liaison_maintenance   = "europe-west1-docker.pkg.dev/PROJECT/solvan/liaison-maintenance@sha256:REPLACE"
  trigger_scheduler     = "europe-west1-docker.pkg.dev/PROJECT/solvan/trigger-scheduler@sha256:REPLACE"
  mcp_facade            = "europe-west1-docker.pkg.dev/PROJECT/solvan/mcp-facade@sha256:REPLACE"
  discord_liaison       = "europe-west1-docker.pkg.dev/PROJECT/solvan/discord-liaison@sha256:REPLACE"
  email_liaison         = "europe-west1-docker.pkg.dev/PROJECT/solvan/email-liaison@sha256:REPLACE"
  relay_control         = "europe-west1-docker.pkg.dev/PROJECT/solvan/relay-control@sha256:REPLACE"
}

fault_drill_enabled = false
direct_gcp_alert_triage_pilot_enabled = false
antigravity_demo_enabled = false
target_product_enabled = false
solvant_relay_enabled = false
solvant_relay_invoker_members = []
calibration_receipt_uri = null
calibration_receipt_hash = null
scheduler_paused = true
deletion_protection = true
# Reaching the console is not signing in to it. `console_public` decides who may
# invoke the service; the settings below decide who may establish an identity
# once there, and the API refuses to start without them.
console_public = false

# Google Workspace domains whose verified accounts may sign in. An empty list
# admits nobody. A verified account at an admitted domain is eligible; an
# explicit membership is what actually lets it in.
admitted_workspace_domains = ["REPLACE_WITH_WORKSPACE_DOMAIN"]

# Secret Manager secret holding this environment's OAuth client secret. One
# client per environment, owned by that environment's project, with
# "${console_url}/api/auth/callback" registered as its redirect URI.
oauth_client_secret_name = "REPLACE_WITH_OAUTH_CLIENT_SECRET_NAME"
operator_step_up_email_relay_url   = "https://REPLACE_WITH_PRIVATE_EMAIL_RELAY"
operator_step_up_pepper_secret_name = "REPLACE_WITH_OPERATOR_STEP_UP_PEPPER_SECRET"

# Granted ADMIN on first sign-in, and only while no administrator exists. Every
# later grant is authored from the console by somebody who already holds ADMIN.
founding_administrator_email = "REPLACE_WITH_FOUNDING_ADMIN_EMAIL"
approver_principals = ["user:REPLACE_WITH_APPROVER_EMAIL"]
