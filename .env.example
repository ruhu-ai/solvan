# Local-only defaults. scripts/dev-env derives unique values per worktree.
SOLVAN_ENVIRONMENT=local
SOLVAN_DEV_HOST=127.0.0.1
SOLVAN_PORT_OFFSET=0
PAYMENTS_REVISION=v2.8.0

# Private actuator deployment settings. No local defaults carry authority.
SOLVAN_DATABASE_URL=
SOLVAN_PLATFORM_AUTHORITY_MODE=
SOLVAN_ALERT_CURSOR_SIGNING_KEY=
SOLVAN_EXECUTION_PRINCIPAL=
SOLVAN_ACTUATOR_IDENTITY=
SOLVAN_PAYMENTS_ADMIN_URL=
SOLVAN_CLOUD_RUN_API_URL=https://run.googleapis.com

# Real Google sign-in, locally. Setting SOLVAN_APPROVAL_AUDIENCE is what switches
# `scripts/start` off the harness fixture and onto Google, so these four belong
# together. Copy this file to `.env` (gitignored) and fill them in.
#
# The redirect URI registered on the client must be this worktree's console
# origin followed by /api/auth/callback. Google matches it exactly and the port
# is derived from the worktree path, so pin the port here and register that
# exact value. `scripts/dev-env --shell` prints the derived one.
SOLVAN_CONSOLE_PORT=
SOLVAN_APPROVAL_AUDIENCE=
SOLVAN_OAUTH_CLIENT_SECRET=
SOLVAN_OPERATOR_STEP_UP_EMAIL_RELAY_URL=
# At least 32 random bytes. Never commit the real value.
SOLVAN_OPERATOR_STEP_UP_PEPPER=
SOLVAN_ADMITTED_DOMAINS=ruhu.ai

# Granted ADMIN on first sign-in, and only while this environment has no
# administrator at all. Every later grant is authored from Settings → Operator
# access by somebody who already holds ADMIN.
SOLVAN_FOUNDING_ADMINISTRATOR=founder@ruhu.ai

# Solvan's own reader identity, in the Solvan control project. It holds no roles:
# it is allowed to impersonate a customer's read-only service account, and that
# account holds the read roles. Your ADC must be able to mint it —
# roles/iam.serviceAccountTokenCreator on this account.
SOLVAN_READER_SERVICE_ACCOUNT=
