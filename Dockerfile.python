# syntax=docker/dockerfile:1.10
FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

ARG APP_MODULE
ARG UV_EXTRAS=
ARG PAYMENTS_REVISION=v2.8.0
ENV APP_MODULE=${APP_MODULE} \
    PAYMENTS_REVISION=${PAYMENTS_REVISION} \
    PATH=/app/.venv/bin:${PATH} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /app
RUN groupadd --system --gid 10001 solvan \
    && useradd --system --uid 10001 --gid solvan --home-dir /app solvan \
    && pip install --no-cache-dir uv==0.10.9

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY apps ./apps
COPY specs/artifacts ./specs/artifacts
RUN test -n "${APP_MODULE}" \
    && uv sync --frozen --no-dev --no-editable ${UV_EXTRAS} \
    && chown -R solvan:solvan /app

USER 10001:10001
EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn \"${APP_MODULE}\" --host 0.0.0.0 --port \"${PORT}\" --no-access-log"]
