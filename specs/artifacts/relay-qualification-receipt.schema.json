{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solvan.dev/schemas/relay-qualification-receipt-v1.json",
  "title": "Solvant Relay customer qualification receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "issued_at", "customer_environment", "deployment", "checks", "attestation"],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "pattern": "^rqr_[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "customer_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "host_profile", "customer_principal_ref"],
      "properties": {
        "region": {"type": "string", "minLength": 2, "maxLength": 63},
        "host_profile": {"enum": ["CLOUD_RUN_JOB", "GKE", "ONPREM_FEDERATED", "ONPREM_KEYFILE"]},
        "customer_principal_ref": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_digest", "policy_digest", "control_audience", "connector_catalog_digest", "redaction_revision", "qualified_adapter_keys"],
      "properties": {
        "image_digest": {"$ref": "#/$defs/digest"},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "control_audience": {"type": "string", "pattern": "^https://"},
        "connector_catalog_digest": {"$ref": "#/$defs/digest"},
        "redaction_revision": {"type": "string", "minLength": 1, "maxLength": 64},
        "qualified_adapter_keys": {
          "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
          "items": {"enum": ["cloud-monitoring.v1", "managed-prometheus.v1", "cloud-logging.v1", "cloud-trace.v1", "kubernetes-metadata.v1"]}
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_ingress", "read_only_identity", "egress_allowlist", "kill_switch", "runtime_proof", "adapter_preflight", "redaction", "receipt_atomicity", "reconciliation"],
      "properties": {
        "no_ingress": {"const": true},
        "read_only_identity": {"const": true},
        "egress_allowlist": {"const": true},
        "kill_switch": {"const": true},
        "runtime_proof": {"const": true},
        "adapter_preflight": {"const": true},
        "redaction": {"const": true},
        "receipt_atomicity": {"const": true},
        "reconciliation": {"const": true}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signed_by", "signature_digest", "evidence_refs"],
      "properties": {
        "signed_by": {"type": "string", "minLength": 1, "maxLength": 512},
        "signature_digest": {"$ref": "#/$defs/digest"},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
      }
    }
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
