{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solvan.dev/schemas/relay-evidence-envelope-v1.json",
  "title": "Locally redacted Solvant Relay evidence envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "collection_job_id", "job_digest", "adapter_key",
    "adapter_revision", "operation", "resource_binding_id", "resource_binding_hash", "window_start",
    "window_end", "observed_at", "classification", "residency_region",
    "redaction_revision", "records"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "collection_job_id": {"type": "string", "pattern": "^rcj_[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "job_digest": {"$ref": "#/$defs/digest"},
    "adapter_key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"},
    "adapter_revision": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"},
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,95}$"},
    "resource_binding_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "resource_binding_hash": {"$ref": "#/$defs/digest"},
    "window_start": {"type": ["string", "null"], "format": "date-time"},
    "window_end": {"type": ["string", "null"], "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "residency_region": {"type": "string", "minLength": 2, "maxLength": 63},
    "redaction_revision": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$"},
    "records": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/metric_point"},
          {"$ref": "#/$defs/log_event"},
          {"$ref": "#/$defs/audit_event"},
          {"$ref": "#/$defs/trace_span"},
          {"$ref": "#/$defs/error_group"},
          {"$ref": "#/$defs/cloud_run_revision"},
          {"$ref": "#/$defs/cloud_sql_metadata"},
          {"$ref": "#/$defs/kubernetes_metadata"}
        ]
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "common_attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service.name": {"type": "string", "maxLength": 128},
        "deployment.environment": {"type": "string", "maxLength": 64},
        "cloud.region": {"type": "string", "maxLength": 63},
        "cloud.availability_zone": {"type": "string", "maxLength": 63},
        "http.route": {"type": "string", "maxLength": 256},
        "http.response.status_code": {"type": "integer", "minimum": 100, "maximum": 599},
        "db.system": {"type": "string", "maxLength": 64},
        "k8s.deployment.name": {"type": "string", "maxLength": 253},
        "k8s.namespace.name": {"type": "string", "maxLength": 63},
        "k8s.resource.kind": {"type": "string", "maxLength": 32},
        "k8s.resource.name": {"type": "string", "maxLength": 253}
      }
    },
    "metric_point": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "metric_key", "timestamp", "value", "unit", "attributes"],
      "properties": {
        "kind": {"const": "METRIC_POINT"}, "metric_key": {"type": "string", "maxLength": 96},
        "timestamp": {"type": "string", "format": "date-time"}, "value": {"type": "number"},
        "unit": {"type": "string", "maxLength": 32}, "attributes": {"$ref": "#/$defs/common_attributes"}
      }
    },
    "log_event": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "timestamp", "severity", "message_template_key", "safe_parameters", "attributes"],
      "properties": {
        "kind": {"const": "LOG_EVENT"}, "timestamp": {"type": "string", "format": "date-time"},
        "severity": {"enum": ["WARNING", "ERROR", "CRITICAL"]},
        "message_template_key": {"type": "string", "maxLength": 96},
        "safe_parameters": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}, "maxProperties": 16},
        "attributes": {"$ref": "#/$defs/common_attributes"}
      }
    },
    "audit_event": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "timestamp", "method_key", "actor_principal_hash", "target_resource_hash", "attributes"],
      "properties": {
        "kind": {"const": "AUDIT_EVENT"}, "timestamp": {"type": "string", "format": "date-time"},
        "method_key": {"type": "string", "maxLength": 96}, "actor_principal_hash": {"$ref": "#/$defs/digest"},
        "target_resource_hash": {"$ref": "#/$defs/digest"}, "attributes": {"$ref": "#/$defs/common_attributes"}
      }
    },
    "trace_span": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "trace_id", "span_id", "name_key", "start_time", "duration_ms", "status", "attributes"],
      "properties": {
        "kind": {"const": "TRACE_SPAN"}, "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "span_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"}, "name_key": {"type": "string", "maxLength": 96},
        "start_time": {"type": "string", "format": "date-time"}, "duration_ms": {"type": "number", "minimum": 0},
        "status": {"enum": ["UNSET", "OK", "ERROR"]}, "attributes": {"$ref": "#/$defs/common_attributes"}
      }
    },
    "error_group": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "group_hash", "signature_key", "first_seen", "last_seen", "count", "attributes"],
      "properties": {
        "kind": {"const": "ERROR_GROUP"}, "group_hash": {"$ref": "#/$defs/digest"},
        "signature_key": {"type": "string", "maxLength": 96}, "first_seen": {"type": "string", "format": "date-time"},
        "last_seen": {"type": "string", "format": "date-time"}, "count": {"type": "integer", "minimum": 0},
        "attributes": {"$ref": "#/$defs/common_attributes"}
      }
    },
    "cloud_run_revision": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "service_resource_hash", "revision_name", "traffic_percent", "observed_generation", "attributes"],
      "properties": {
        "kind": {"const": "CLOUD_RUN_REVISION"}, "service_resource_hash": {"$ref": "#/$defs/digest"},
        "revision_name": {"type": "string", "maxLength": 128}, "traffic_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "observed_generation": {"type": "integer", "minimum": 1}, "attributes": {"$ref": "#/$defs/common_attributes"}
      }
    },
    "cloud_sql_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "instance_resource_hash", "database_version", "state", "region", "attributes"],
      "properties": {
        "kind": {"const": "CLOUD_SQL_METADATA"}, "instance_resource_hash": {"$ref": "#/$defs/digest"},
        "database_version": {"type": "string", "maxLength": 64}, "state": {"type": "string", "maxLength": 64},
        "region": {"type": "string", "maxLength": 63}, "attributes": {"$ref": "#/$defs/common_attributes"}
      }
    },
    "kubernetes_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "namespace", "resource_kind", "resource_name", "created_at", "labels", "attributes"],
      "properties": {
        "kind": {"const": "KUBERNETES_METADATA"},
        "namespace": {"type": "string", "maxLength": 63},
        "resource_kind": {"enum": ["Deployment", "StatefulSet", "DaemonSet", "Pod", "Service"]},
        "resource_name": {"type": "string", "maxLength": 253},
        "created_at": {"type": "string", "format": "date-time"},
        "labels": {"type": "object", "maxProperties": 16, "additionalProperties": {"type": "string", "maxLength": 256}},
        "attributes": {"$ref": "#/$defs/common_attributes"}
      }
    }
  }
}
