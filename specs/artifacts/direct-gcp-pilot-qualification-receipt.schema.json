{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solvan.dev/schemas/direct-gcp-pilot-qualification-receipt-v1.json",
  "title": "Solvan Direct GCP Pilot Qualification Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "receipt_id", "issued_at", "expires_at", "deployment", "direct_connection", "alert_source", "results", "manual_continuation", "independent_verification"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "SOLVAN_DIRECT_GCP_PILOT_QUALIFICATION"},
    "receipt_id": {"type": "string", "pattern": "^pgq_[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "deployment": {
      "type": "object", "additionalProperties": false,
      "required": ["control_project_id", "region", "source_commit", "alert_ingress_revision", "api_revision", "coordinator_revision", "qualification_verifier_revision"],
      "properties": {
        "control_project_id": {"$ref": "#/$defs/project_id"},
        "region": {"type": "string", "minLength": 2, "maxLength": 63},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "alert_ingress_revision": {"type": "string", "minLength": 1, "maxLength": 255},
        "api_revision": {"type": "string", "minLength": 1, "maxLength": 255},
        "coordinator_revision": {"type": "string", "minLength": 1, "maxLength": 255},
        "qualification_verifier_revision": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    },
    "direct_connection": {
      "type": "object", "additionalProperties": false,
      "required": ["connection_id", "connection_epoch", "authentication_mode", "solvan_delegator_principal", "customer_reader_principal", "delegation_condition_digest", "capability_receipt_ref"],
      "properties": {
        "connection_id": {"type": "string", "pattern": "^con_[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
        "connection_epoch": {"type": "integer", "minimum": 1},
        "authentication_mode": {"const": "GCP_SERVICE_ACCOUNT_IMPERSONATION"},
        "solvan_delegator_principal": {"$ref": "#/$defs/principal"},
        "customer_reader_principal": {"$ref": "#/$defs/principal"},
        "delegation_condition_digest": {"$ref": "#/$defs/digest"},
        "capability_receipt_ref": {"$ref": "#/$defs/evidence_ref"}
      }
    },
    "alert_source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_binding_id", "source_binding_epoch", "configuration_digest", "subscription", "push_service_account", "oidc_audience", "qualification_delivery_ref"],
      "properties": {
        "source_binding_id": {"type": "string", "pattern": "^asb_[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
        "source_binding_epoch": {"type": "integer", "minimum": 1},
        "configuration_digest": {"$ref": "#/$defs/digest"},
        "subscription": {"type": "string", "pattern": "^projects/[^/]+/subscriptions/[^/]+$"},
        "push_service_account": {"$ref": "#/$defs/principal"},
        "oidc_audience": {"type": "string", "pattern": "^https://"},
        "qualification_delivery_ref": {"$ref": "#/$defs/evidence_ref"}
      }
    },
    "results": {
      "type": "object", "additionalProperties": false,
      "required": ["delegation_verified", "ingress_isolation_verified", "authenticated_delivery_verified", "read_only_triage_verified", "operator_continuation_verified"],
      "properties": {
        "delegation_verified": {"const": true},
        "ingress_isolation_verified": {"const": true},
        "authenticated_delivery_verified": {"const": true},
        "read_only_triage_verified": {"const": true},
        "operator_continuation_verified": {"const": true}
      }
    },
    "manual_continuation": {
      "type": "object", "additionalProperties": false,
      "required": ["operator_principal_ref", "continuation_receipt_ref"],
      "properties": {
        "operator_principal_ref": {"$ref": "#/$defs/evidence_ref"},
        "continuation_receipt_ref": {"$ref": "#/$defs/evidence_ref"}
      }
    },
    "independent_verification": {
      "type": "object", "additionalProperties": false,
      "required": ["verifier_principal", "verifier_revision", "kms_key_version", "signature_digest", "evidence_refs"],
      "properties": {
        "verifier_principal": {"$ref": "#/$defs/principal"},
        "verifier_revision": {"type": "string", "minLength": 1, "maxLength": 255},
        "kms_key_version": {"type": "string", "minLength": 1, "maxLength": 1024},
        "signature_digest": {"$ref": "#/$defs/digest"},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/evidence_ref"}}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,62}$"},
    "principal": {"type": "string", "minLength": 1, "maxLength": 512},
    "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 1024}
  }
}
